pipelineJob('install-app') {
    description('App install pipeline')
    
    logRotator {
        numToKeep(5)
        daysToKeep(1)
    }

    definition {
        cpsScm {
            scm {
                git {
                    remote {
                        url( '{{ app_scm_url }}' )
                    }
                    branches('main')
                }
            }
            scriptPath('Jenkinsfile')
        }
    }
}